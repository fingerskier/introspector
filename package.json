{
  "name": "introspector",
  "version": "0.1.0",
  "description": "Build a mindmap and guided tour of a repo or document set.",
  "type": "module",
  "bin": {
    "introspector": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "introspect": "node src/cli.ts",
    "check": "tsc --noEmit",
    "test": "node --test",
    "build": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "mindmap",
    "guided-tour",
    "codebase",
    "documentation",
    "introspection",
    "claude",
    "claude-code"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.6.0"
  }
}
